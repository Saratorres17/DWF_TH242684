{
  "info": {
    "name": "Todo API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección de ejemplos para la API de tareas pendiente (Todo List) desarrollada en Spring Boot."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Get All Tasks",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/tasks",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "tasks"
          ]
        }
      }
    },
    {
      "name": "Add New Task",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Hacer gu\\u00eda 2\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/tasks",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "tasks"
          ]
        }
      }
    },
    {
      "name": "Mark Task as Completed",
      "request": {
        "method": "PUT",
        "url": {
          "raw": "{{base_url}}/api/tasks/1/complete",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "tasks",
            "1",
            "complete"
          ]
        }
      }
    },
    {
      "name": "Update Task",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Descripci\\u00f3n actualizada\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/tasks/1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "tasks",
            "1"
          ]
        }
      }
    },
    {
      "name": "Delete Task",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{base_url}}/api/tasks/1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "tasks",
            "1"
          ]
        }
      }
    },
    {
      "name": "Search Tasks",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/tasks/search?keyword=guia",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "tasks",
            "search"
          ],
          "query": [
            {
              "key": "keyword",
              "value": "guia"
            }
          ]
        }
      }
    }
  ]
}